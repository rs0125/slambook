# Supabase Project Settings > API. Copy values to ignored .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Runtime: transaction pooler on Vercel. db:setup creates slambook_app's password.
DATABASE_URL=postgresql://slambook_app.PROJECT_REF:APP_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Migration/setup only. Do not add this administrative credential to Vercel.
DIRECT_URL=postgresql://postgres:DATABASE_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
# Confirm the owner in Supabase Auth; db:setup binds this UUID to the book.
OWNER_USER_ID=
# Exact deployment origin, without a trailing slash.
APP_ORIGIN=http://localhost:6001
# Generate independent random values: openssl rand -hex 32
RATE_LIMIT_SECRET=
CRON_SECRET=
# On Vercel, its trusted x-vercel-forwarded-for header is used automatically.
# Only set behind a reverse proxy that OVERWRITES this header (never appends).
# TRUSTED_IP_HEADER=x-real-ip
